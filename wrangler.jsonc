{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pumblechook",
  "compatibility_date": "2026-11-13",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "pumblechook.com", "custom_domain": true }],
  "preview_urls": true,
  "previews": {}
}
