---
import { parsePortfolio } from "../../core/portfolio/index.ts";
import Tall from "../compositions/Tall.astro";
import Wide from "../compositions/Wide.astro";
import { PORTFOLIO_CONTENT } from "../content/portfolio.ts";

const parsed = parsePortfolio(PORTFOLIO_CONTENT);
if (Array.isArray(parsed)) {
  const complaints = parsed.map((broken) => `${broken.rule}: "${broken.badValue}"`);
  throw new Error(`The content breaks the portfolio rules.\n${complaints.join("\n")}`);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pumblechook</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="stylesheet" href="/fonts/fonts.css" />
  </head>
  <body>
    <main>
      <Wide portfolio={parsed} />
      <Tall portfolio={parsed} />
    </main>
  </body>
</html>
