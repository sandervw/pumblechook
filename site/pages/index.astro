---
import { parsePortfolio } from "../../core/portfolio/index.ts";
import { PORTFOLIO_CONTENT } from "../content/portfolio.ts";

const parsed = parsePortfolio(PORTFOLIO_CONTENT);
if (Array.isArray(parsed)) {
  const complaints = parsed.map((broken) => `${broken.rule}: "${broken.badValue}"`);
  throw new Error(`The content breaks the portfolio rules.\n${complaints.join("\n")}`);
}
const { ownerMark, projects } = parsed;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Pumblechook</title>
  </head>
  <body>
    <main>
      <h1>{ownerMark.name}</h1>
      <p>{ownerMark.tag}</p>
      <p>“{ownerMark.bio}”</p>
      <ul>
        <li><a href={ownerMark.gitHubLink}>GitHub</a></li>
        <li><a href={ownerMark.linkedInLink}>LinkedIn</a></li>
      </ul>
      <ol>
        {
          projects.map((project) => (
            <li>
              <h2>
                <a href={project.liveSiteLink}>{project.name}</a>
              </h2>
              <p>
                {project.logline}
                {project.repositoryLink && (
                  <a href={project.repositoryLink} aria-label={`${project.name} (code)`}>
                    <i>(code)</i>
                  </a>
                )}
              </p>
            </li>
          ))
        }
      </ol>
    </main>
  </body>
</html>
