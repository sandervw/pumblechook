---
import type { Portfolio } from "../../core/portfolio/index.ts";
import background from "../art/background.webp";
import body from "../art/body.webp";
import floor from "../art/floor.webp";
import rib from "../art/rib.webp";
import weedOne from "../art/weed-1.webp";
import weedTwo from "../art/weed-2.webp";
import { LID_REST, lidPath } from "../scene/eyes.ts";
import { centreLine, firstWriggle, limbLength, linePath, outlinePath, reachBox, STILL } from "../scene/limb.ts";
import "../scene/scene.css";
import { loadMeasure } from "./measure.ts";
import Paints from "./Paints.astro";
import Rows from "./Rows.astro";
import Swarm from "./Swarm.astro";
import Tattoos from "./Tattoos.astro";
import { layOutOwner, layOutProject } from "./rows.ts";
import { WIDE } from "./wide-layout.ts";

interface Props {
  portfolio: Portfolio;
}

// Text stops short of an arm's narrow tip.
const TEXT_REACH = 0.9;
const PREFIX = "wide";
const paint = (name: string) => `url(#${PREFIX}-${name})`;

const { ownerMark, projects } = Astro.props.portfolio;
const measure = loadMeasure();
const arms = WIDE.arms.map((limb, armIndex) => {
  const points = centreLine(limb.curve, firstWriggle(armIndex));
  const room = limbLength(centreLine(limb.curve, STILL)) * TEXT_REACH;
  return {
    armIndex,
    box: reachBox(limb),
    outline: outlinePath(limb, points),
    line: linePath(points),
    blocks: layOutProject(projects[armIndex], limb, room, measure),
  };
});
// Later arms lie under earlier ones.
const papers = arms.toReversed();
const ribLine = linePath(centreLine(WIDE.rib.curve, STILL));
const ownerBlocks = layOutOwner(ownerMark, WIDE.rib, measure);
const lids = WIDE.eyes.map((eye) => lidPath(eye, LID_REST));
---

<svg id="wide" class="scene" viewBox="0 0 960 540" preserveAspectRatio="xMidYMid meet" role="presentation">
  <Paints prefix={PREFIX} frame={[960, 540]} glow={{ centre: [150, 140], radius: 820 }}>
    <!-- Softens a cut edge, then drops a paper shadow. -->
    {
      arms.map((arm) => (
        <filter id={`${PREFIX}-cut-${arm.armIndex}`} filterUnits="userSpaceOnUse" x={arm.box.left} y={arm.box.top} width={arm.box.width} height={arm.box.height}>
          <feGaussianBlur stdDeviation="0.45" result="cut" />
          <feDropShadow in="cut" dx="2" dy="4" stdDeviation="3.5" flood-color="#000" flood-opacity="0.6" />
        </filter>
      ))
    }
    <mask id={`${PREFIX}-body-shape`} style="mask-type: alpha">
      <image href={body.src} x="-390" y="-530" width="780" height="530" preserveAspectRatio="none" transform="translate(-115 -125) rotate(135)"></image>
    </mask>
  </Paints>

  <g aria-hidden="true">
    <image href={background.src} width="960" height="540" preserveAspectRatio="xMidYMid slice"></image>
    <image class="light" href={background.src} width="960" height="540" preserveAspectRatio="xMidYMid slice"></image>
    <Swarm prefix={PREFIX} water={WIDE.water} size={1} />
    <image href={rib.src} {...WIDE.rib.art} filter={paint("bone")}></image>
    <g transform="translate(-10 384) scale(0.638)" filter={paint("shadow")}>
      <image href={floor.src} width="1536" height="307"></image>
      <image class="weed" href={weedOne.src} width="139" height="158"></image>
      <image class="weed" href={weedTwo.src} x="1342" width="158" height="166"></image>
    </g>
  </g>

  <g class="words owner" transform="translate(0 -11)">
    <path id={`${PREFIX}-rib-line`} d={ribLine} fill="none"></path>
    <Rows blocks={ownerBlocks} lineId={`${PREFIX}-rib-line`} />
  </g>

  <g aria-hidden="true">
    {
      papers.map((arm) => (
        <g class="paper" data-arm={arm.armIndex} filter={paint(`cut-${arm.armIndex}`)}>
          <path d={arm.outline} fill={paint("rust-dark")} />
          <path d={arm.outline} fill={paint("glow")} />
        </g>
      ))
    }
  </g>

  <g class="words" role="list">
    {
      arms.map((arm) => (
        <g role="listitem" data-arm={arm.armIndex}>
          <path id={`${PREFIX}-arm-${arm.armIndex}-line`} d={arm.line} fill="none" />
          <Rows blocks={arm.blocks} lineId={`${PREFIX}-arm-${arm.armIndex}-line`} />
        </g>
      ))
    }
  </g>

  <g aria-hidden="true" pointer-events="none">
    <g filter={paint("shadow")}>
      <g mask={paint("body-shape")}>
        <rect x="-20" y="-20" width="440" height="420" fill={paint("rust")}></rect>
        <rect x="-20" y="-20" width="440" height="420" fill={paint("glow")}></rect>
      </g>
    </g>
  </g>

  <g aria-hidden="true">
    {
      WIDE.eyes.map((eye, eyeIndex) => (
        <g class="eye">
          <circle cx={eye.centre[0]} cy={eye.centre[1]} r={eye.radius} fill={paint("yellow")} filter={paint("shadow")} />
          <circle cx={eye.centre[0]} cy={eye.centre[1]} r={eye.radius} fill={paint("eye-glow")} />
          <circle cx={eye.pupil[0]} cy={eye.pupil[1]} r={eye.pupilRadius} fill="#17110b" />
          <g class="lid" filter={paint("shadow")}>
            <path d={lids[eyeIndex]} fill={paint("rust-dark")} />
            <path d={lids[eyeIndex]} fill={paint("glow")} />
          </g>
        </g>
      ))
    }
  </g>

  <Tattoos prefix={PREFIX} profileLink={ownerMark.profileLink} places={WIDE.tattoos} />

  <!-- One sheet of paper grain over everything, words too, flattens the collage. -->
  <g aria-hidden="true" pointer-events="none">
    <rect width="960" height="540" fill={paint("vignette")}></rect>
    <rect class="grain" width="960" height="540" fill={paint("grain")}></rect>
    <rect class="parchment" width="960" height="540"></rect>
  </g>
</svg>

<script>
  import { runScene } from "../scene/scene.ts";
  import { WIDE } from "./wide-layout.ts";

  const scene = document.querySelector("#wide");
  if (!scene) {
    throw new Error("The page lacks its #wide picture.");
  }
  runScene(scene, WIDE);
</script>
