---
// The paints, filters, and clips one composition's pieces use.
import grain from "../art/grain.webp";
import rustDark from "../art/rust-dark.webp";
import rust from "../art/rust.webp";
import yellow from "../art/yellow.webp";
import type { Point } from "../scene/limb.ts";
import { FISH_KINDS } from "./fish.ts";

interface Props {
  /** Starts every id, so two compositions can share a page. */
  prefix: string;
  /** The composition's width and height. */
  frame: Point;
  /** Where the inner glow is brightest, and how far it reaches. */
  glow: { centre: Point; radius: number };
}

const { prefix, frame, glow } = Astro.props;
const [width, height] = frame;
---

<defs>
  <pattern id={`${prefix}-rust`} patternUnits="userSpaceOnUse" width={width} height={height}>
    <image href={rust.src} width={width} height={height} preserveAspectRatio="xMidYMid slice"></image>
  </pattern>
  <pattern id={`${prefix}-rust-dark`} patternUnits="userSpaceOnUse" width={width} height={height}>
    <image href={rustDark.src} width={width} height={height} preserveAspectRatio="xMidYMid slice"></image>
  </pattern>
  <pattern id={`${prefix}-yellow`} patternUnits="userSpaceOnUse" width="240" height="240">
    <image href={yellow.src} width="240" height="240"></image>
  </pattern>
  <!-- Tattoo ink, bled a little into the skin. -->
  <filter id={`${prefix}-faded`} x="-10%" y="-20%" width="120%" height="140%">
    <feTurbulence type="fractalNoise" baseFrequency="0.4" numOctaves="1" seed="9" result="skin"></feTurbulence>
    <feDisplacementMap in="SourceGraphic" in2="skin" scale="1.4" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    <feGaussianBlur stdDeviation="0.35"></feGaussianBlur>
  </filter>
  <pattern id={`${prefix}-grain`} patternUnits="userSpaceOnUse" width="320" height="320">
    <image href={grain.src} width="320" height="320"></image>
  </pattern>
  <filter id={`${prefix}-bone`} x="-20%" y="-20%" width="140%" height="150%">
    <feComponentTransfer result="pale">
      <feFuncR type="linear" slope="1.18"></feFuncR>
      <feFuncG type="linear" slope="1.18"></feFuncG>
      <feFuncB type="linear" slope="1.18"></feFuncB>
    </feComponentTransfer>
    <feDropShadow in="pale" dx="1" dy="3" stdDeviation="2.5" flood-color="#000" flood-opacity="0.6"></feDropShadow>
  </filter>
  <filter id={`${prefix}-shadow`} x="-20%" y="-20%" width="140%" height="150%">
    <feDropShadow dx="1" dy="3" stdDeviation="2.5" flood-color="#000" flood-opacity="0.6"></feDropShadow>
  </filter>

  <radialGradient id={`${prefix}-glow`} gradientUnits="userSpaceOnUse" cx={glow.centre[0]} cy={glow.centre[1]} r={glow.radius}>
    <stop offset="0" stop-color="#ffc45a" stop-opacity="0.78"></stop>
    <stop offset="0.22" stop-color="#ff8a2a" stop-opacity="0.3"></stop>
    <stop offset="0.6" stop-color="#2a0500" stop-opacity="0.12"></stop>
    <stop offset="1" stop-color="#150200" stop-opacity="0.62"></stop>
  </radialGradient>
  <radialGradient id={`${prefix}-eye-glow`}>
    <stop offset="0" stop-color="#fff6a8" stop-opacity="0.85"></stop>
    <stop offset="0.6" stop-color="#ffc21f" stop-opacity="0.1"></stop>
    <stop offset="1" stop-color="#7a3a00" stop-opacity="0.65"></stop>
  </radialGradient>
  <radialGradient id={`${prefix}-vignette`} cx="0.45" cy="0.45" r="0.75">
    <stop offset="0.45" stop-color="#000" stop-opacity="0"></stop>
    <stop offset="1" stop-color="#000" stop-opacity="0.72"></stop>
  </radialGradient>
  {
    FISH_KINDS.map((kind, kindIndex) => (
      <clipPath id={`${prefix}-fish-eye-${kindIndex}`}>
        <circle cx={kind.left + kind.eye[0]} cy={kind.top + kind.eye[1]} r={kind.eyeRadius} />
      </clipPath>
    ))
  }
  <slot />
</defs>
